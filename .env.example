# Nightwatch AI Configuration
APP_NAME=Nightwatch AI
APP_ENV=development
DEBUG=true
PORT=3000
API_V1_STR=/api/v1
SECRET_KEY=dev-nightwatch-insecure-secret-key-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=nightwatch
POSTGRES_PASSWORD=nightwatch_secure_pass
POSTGRES_DB=nightwatch_db
DATABASE_URL=postgresql+psycopg2://nightwatch:nightwatch_secure_pass@localhost:5432/nightwatch_db

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Machine Learning
MODEL_VERSION=2.1.0
ANOMALY_SCORE_THRESHOLD=55.0
ISOLATION_FOREST_TREES=100
MAX_SAMPLES=256

# Telemetry Ingestion
INGESTION_API_KEY=nw_live_99f0b32c81d77a02e647
MAX_BATCH_SIZE=5000
RATE_LIMIT_PER_MINUTE=10000

# Observability
PROMETHEUS_METRICS_ENABLED=true
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
